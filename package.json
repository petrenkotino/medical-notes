{
  "name": "medical-notes",
  "version": "1.0.0",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "test": "tsx --test tests/correctness.test.ts",
    "dev": "tsx watch src/index.ts",
    "build": "rm -rf dist && tsc && mkdir -p dist/db/migrations && cp src/db/migrations/*.sql dist/db/migrations/",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/sensible": "^6.0.0",
    "dotenv": "^18.0.0",
    "fastify": "^5.0.0",
    "postgres": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
